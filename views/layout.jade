doctype html
html(lang="en", data-theme="light")
  head
    title Student Logs
    meta(charset="UTF-8")
    link(rel="stylesheet", href="/stylesheets/style.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css?family=Rajdhani:400,500,600,700|Raleway:400,500,600,700,800,900|Lato:400,500,600,700,800,900|Montserrat:400,500,600,700,800,900")
    if school === 'uvu'
      link(rel="icon", type="image/png", href="https://www.uvu.edu/favicon.ico")
    else if school === 'uofu'
      link(rel="icon", type="image/png", href="https://www.utah.edu/favicon.ico")
    script(src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js")
    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    script.
      if (localStorage.getItem('displayPref')) {
        $('html').attr('data-bs-theme', localStorage.getItem('displayPref'));
      } else {
        const theme = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        $('html').attr('data-bs-theme', theme);
        localStorage.setItem('displayPref', theme);
      }
      $(window).on("load", function() {
        const theme = localStorage.getItem('displayPref') === 'light' ? true : false;
        $('#dark_light').prop('checked', theme);
      });

  body.padding-top(class=school)
    nav.navbar.fixed-top.bg-body-tertiary
      .container-fluid
        a.navbar-brand(href="/")
          if school === 'uvu'
            img(src="https://www.uvu.edu/sbdc/images/logos/uvu-logo-green.png", height="40", alt="UVU Logo")
          else if school === 'uofu'
            img(src="https://upload.wikimedia.org/wikipedia/commons/thumb/9/92/Utah_Utes_-_U_logo.svg/3840px-Utah_Utes_-_U_logo.svg.png", height="30", alt="UofU Logo")
        if user
          span.navbar-text.p-2 #{user.username}
          a.nav-link(href='/#{user.school}/logout') Logout
        else
          a.navbar-text.p-2.text-decoration-none(href="/") Home
          a.navbar-text.p-2.text-decoration-none(href="/#{school}/login") Login
        .form-check.form-switch.ms-auto.navbar-text
          input.form-check-input(type="checkbox", id="dark_light", name="dark_light", onchange="setMode(this)")
          label.form-check-label.me-2(id="lightordark", for="dark_light") Light mode

    block content

  script.
    if (typeof jQuery === 'undefined') {
      var script = document.createElement('script');
      script.src = 'https://code.jquery.com/jquery-3.7.1.min.js';
      document.head.appendChild(script);
    }
  script(src="/javascripts/theme.js")
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
  block scripts