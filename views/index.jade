extends layout

block content
    .d-flex.justify-content-center.align-items-center.vh-100
        .text-center
            h2.mb-4 Welcome
            p.text-muted.mb-5 Select your school to continue
            .d-flex.gap-4.justify-content-center

                a.text-decoration-none(href='/uvu/login')
                    .card.p-4(style='width: 220px; border-top: 4px solid #275d38;')
                        img(src="https://www.uvu.edu/sbdc/images/logos/uvu-logo-green.png", height="60", alt="UVU Logo").mb-3
                        h5.fw-bold Utah Valley University
                        p.text-muted.small Orem, Utah
                        span.btn.btn-sm.mt-2(style='background-color: #275d38; color: white;') Login

                a.text-decoration-none(href='/uofu/login')
                    .card.p-4(style='width: 220px; border-top: 4px solid #820000;')
                        img(src="https://logos-world.net/wp-content/uploads/2023/05/University-of-Utah-Logo.png", height="60", alt="UofU Logo").mb-3
                        h5.fw-bold University of Utah
                        p.text-muted.small Salt Lake City, Utah
                        span.btn.btn-sm.mt-2(style='background-color: #820000; color: white;') Login