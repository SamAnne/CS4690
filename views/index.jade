doctype html
html(lang="en", data-theme="light")
  head
    title Student Logs
    meta(charset="UTF-8")
    link(rel="stylesheet", href="./stylesheets/style.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css?family=Rajdhani:400,500,600,700|Raleway:400,500,600,700,800,900|Lato:400,500,600,700,800,900|Montserrat:400,500,600,700,800,900")
    link(rel="icon", type="image/png", href="https://www.uvu.edu/favicon.ico")
    script(src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js")
    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    //- For the chrome flashbang
    script.
      if (localStorage.getItem('displayPref')) {
        $('html').attr('data-bs-theme', localStorage.getItem('displayPref'));
      } else {
        const theme = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
        $('html').attr('data-bs-theme', theme);
        localStorage.setItem('displayPref', theme);
      }
      $(window).on("load", function() {
        const theme = localStorage.getItem('displayPref') === 'light' ? true : false;
        $('#dark_light').prop('checked', theme);
      });

  body.padding-top
    nav.navbar.fixed-top.bg-body-tertiary
      .container-fluid
        a.navbar-brand(href="")
          img(src="https://www.uvu.edu/sbdc/images/logos/uvu-logo-green.png", height="40", alt="UVU Logo")
        span.navbar-text Student Logs
        .form-check.form-switch.ms-auto
          input.form-check-input(type="checkbox", id="dark_light", name="dark_light", onchange="setMode(this)")
          label.form-check-label.me-2(id="lightordark", for="dark_light") Light mode

    .d-flex.justify-content-center.align-items-center.vh-100
      .rounded.card.p-4.w-50.text-center
        form.d-flex.flex-column.gap-3
          label(for="courseAdd") Add a course
          br
          input(
            type="text"
            id="courseAdd",
            name="courseAdd"
          )
          button.btn.btn-outline-secondary(
            type="button",
            onclick="PostCourse()",
            id="submitCourse"
          ) Add Course
          label(for="course") Select a course
          br
          select(
            aria-label="Select Course",
            id="course",
            name="course",
            data-cy="course_select",
            onchange="displayUVUID(value)"
          )
          br
          label(for="uvuId") UVU ID
          br
          //- oninput here makes it so only numbers are typed
          input(
            type="text",
            id="uvuId",
            name="uvuId",
            data-cy="uvuId_input",
            oninput="this.value = this.value.replace(/[^0-9]/g, '');",
            maxlength="8",
            placeholder="10234567"
          )
          h5(id="uvuIdDisplay", data-cy="uvuIdDisplay") Student Logs for
          ul(data-cy="logs", id="logs", onclick="hideLog(this)").list-group.overflow-auto.border
          #bottom
            label.p-2 New Log
            br
            textarea(
              style="height: 75px",
              aria-label="add log textarea",
              data-cy="log_textarea",
              id="logText",
              oninput="postLog()"
            )
            br
            button.btn.btn-outline-secondary(
              type="submit",
              data-cy="add_log_btn",
              onclick="submitButton(event)",
              id="submit"
            ) Add Log

    script.
      if (typeof jQuery === 'undefined') {
        var script = document.createElement('script');
        script.src = 'https://code.jquery.com/jquery-3.7.1.min.js';
        document.head.appendChild(script);
      }
    script(src="./javascripts/script.js")
