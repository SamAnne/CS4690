extends layout

block content  
  .d-flex.justify-content-center.align-items-center.vh-100
    .rounded.card.p-4.w-50.text-center
      form.d-flex.flex-column.gap-3
        if user && user.role === 'teacher'
          label(for="courseAdd") Add a course
          br
          input(
            type="text"
            id="courseAdd",
            name="courseAdd"
          )
          button.btn.btn-outline-secondary(
            type="button",
            onclick="PostCourse()",
            id="submitCourse"
          ) Add Course
        label(for="course") Select a course
        br
        select(
          aria-label="Select Course",
          id="course",
          name="course",
          data-cy="course_select",
          onchange="displayUVUID(value)"
        )
        br
        label(for="uvuId") UVU ID
        br
        //- oninput here makes it so only numbers are typed
        input(
          type="text",
          id="uvuId",
          name="uvuId",
          data-cy="uvuId_input",
          oninput="this.value = this.value.replace(/[^0-9]/g, '');",
          maxlength="8",
          placeholder="10234567"
        )
        h5(id="uvuIdDisplay", data-cy="uvuIdDisplay") Student Logs for
        ul(data-cy="logs", id="logs", onclick="hideLog(this)").list-group.overflow-auto.border
        #bottom
          label.p-2 New Log
          br
          textarea(
            style="height: 75px",
            aria-label="add log textarea",
            data-cy="log_textarea",
            id="logText",
            oninput="postLog()"
          )
          br
          button.btn.btn-outline-secondary(
            type="submit",
            data-cy="add_log_btn",
            onclick="submitButton(event)",
            id="submit"
          ) Add Log

block scripts
  script(src="./javascripts/script.js")
  
