extends layout

block content 
  .d-flex.justify-content-center.align-items-center.vh-100
    .rounded.card.p-4.w-50.text-center
      form#signupForm(method='POST', action='/signup' novalidate).d-flex.flex-column.gap-3
        if error
            .alert.alert-danger= error
        h1 Sign up
        label(for="username") Username
        br
        input#username(
          type="text",
          name="username",
          required,
          minlength='3'
        )
        .invalid-feedback Username is required
        label(for="password") Password
        br
        input#password(
          type="password",
          name="password",
          required,
          minlength='6'
        )
        .invalid-feedback Password must be at least 6 characters
        br
        label(for="") Choose your role
        .form-check
            input#student.form-check-input(
                type="radio",
                value='student',
                name="role",
                required,
                checked
            )
            label.form-check-label(
                for="student"
            ) Student
        .form-check    
            input#teacher.form-check-input(
                type="radio",
                value='teacher',
                name="role"
            )
            label.form-check-label(
                for="teacher"
            ) Teacher
        button#signup.btn.btn-outline-secondary(
          type="submit",
          data-cy="",
        ) Sign Up
block scripts 
    script.
        const form = document.getElementById('signupForm');
        form.addEventListener('submit', function(e) {
        if (!form.checkValidity()) {
            e.preventDefault();
            e.stopPropagation();
        }
        form.classList.add('was-validated');
        });