{
  "name": "node-starter",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && npx tsc public/javascripts/script.ts --target ES2020 --skipLibCheck true --strict false",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "node ./dist/bin/www.js",
    "dev": "npm run build && node ./dist/bin/www.js"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jquery": "^3.5.33",
    "@types/mongodb": "^4.0.7",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "copyfiles": "^2.4.1",
    "json-server": "0.17.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "body-parser": "^2.2.2",
    "class-transformer": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "jade": "^1.11.0",
    "jquery": "^4.0.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "reflect-metadata": "^0.2.2"
  }
}
